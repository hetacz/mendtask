<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CI CD Suite" verbose="3" thread-count="4">

    <test name="GitHub API Tests" parallel="methods" group-by-instances="true">

        <parameter name="browser" value="firefox"/>
        <parameter name="headless" value="true"/>
        <parameter name="aut" value="github"/>

        <groups>
            <run>
                <exclude name="ui"/>
            </run>
        </groups>

        <packages>
            <package name="com.hetacz.mendtask.tests.github"/>
        </packages>
    </test>

    <test name="GitHub UI Tests" parallel="methods" group-by-instances="true">

        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <parameter name="aut" value="github"/>

        <groups>
            <run>
                <exclude name="api"/>
            </run>
        </groups>

        <packages>
            <package name="com.hetacz.mendtask.tests.github"/>
        </packages>
    </test>

    <test name="Gitlab Tests" parallel="methods" group-by-instances="true">

        <parameter name="browser" value="edge"/>
        <parameter name="headless" value="true"/>
        <parameter name="aut" value="gitlab"/>

        <groups>
            <run>
                <exclude name="github"/>
            </run>
        </groups>

        <packages>
            <package name="com.hetacz.mendtask.tests.gitlab"/>
        </packages>
    </test>
</suite>
