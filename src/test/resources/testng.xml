<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GitHub Suite" verbose="3" thread-count="4">

    <test name="GitHub Test" parallel="methods" group-by-instances="true">

        <parameter name="browser" value="EDGE"/>
        <parameter name="headless" value="false"/>
        <parameter name="aut" value="GITHUB"/>

        <packages>
            <package name="com.hetacz.mendtask.tests.github"/>
        </packages>
    </test>

    <test name="Gitlab Test" parallel="methods" group-by-instances="true">

        <parameter name="browser" value="FIREFOx"/>
        <parameter name="headless" value="false"/>
        <parameter name="aut" value="gitlaB"/>

        <groups>
            <run>
                <exclude name="github"/>
            </run>
        </groups>

        <packages>
            <package name="com.hetacz.mendtask.tests.gitlab"/>
        </packages>
    </test>
</suite>
